""0  1
E "#uses \"classes/testFramework/testSuite/TfTestSuite\"

TfTestSuite testSuite;

//--------------------------------------------------------------------------------
public setTestSuite(const TfTestSuite &suite)
{
  testSuite = suite;
 // DebugTN(__FUNCTION__, testSuite.getId(), testSuite);
  suiteCommonConfigRef.setId(testSuite.getId());
  suiteCommonConfigRef.setName(testSuite.getName());
  suiteCommonConfigRef.setDescription(testSuite.getDescription());

  treeTestProjects.updatesEnabled(FALSE);
  treeTestProjects.clear();
  const dyn_anytype projects = testSuite.getProjectsList();

  for (int i = 1; i <= dynlen(projects); i++)
  {
    anytype proj = projects[i];
    string treeId = \"proj_\" + i;
    addProjInList(proj, treeId, \"\");
  }

  addUserData(testSuite.getUserData());

  expandFirstElement(\"\");

  treeTestProjects.updatesEnabled(TRUE);
}

void expandFirstElement(string id)
{
  treeTestProjects.setSelectedItem(id, true);
  dyn_string children = treeTestProjects.children(id);
  if (children.count() > 0)
  {
    treeTestProjects.setOpen(id, true);
    id = children.at(0);
    expandFirstElement(id);
  }
}

//--------------------------------------------------------------------------------
void addProjInList(const anytype &proj, const string &treeId, const string &rootId)
{
  treeTestProjects.appendItem(rootId, treeId, \"\");

  if (isA(proj, STRING_VAR))
  {
    treeTestProjects.setText(treeId, 0, proj);
  }
  else if (isA(proj, MAPPING_VAR))
  {
    treeTestProjects.setText(treeId, 0, proj[\"PROJECT_CONFIG\"]);
  }
  else if (isDynVar(proj))
  {
    // parallel projects
    treeTestProjects.setText(treeId, 0, \"Parallel\");

    for (int i = 1; i <= dynlen(proj); i++)
    {
      addProjInList(proj[i], treeId + \"_P_\" + i, treeId);
    }
  }
}


void addUserData(const anytype &userData)
{
  DebugTN(__FUNCTION__, userData);
  shape sh = getShape(\"treeTestSuiteUserData\");
  sh.updatesEnabled(FALSE);
  sh.clear();

  if (isNull(userData))
  {
    LAYOUT_GROUP57.visible(false);
    PANEL_REF4.visible(false);
    // hide it and do nothing
    sh.updatesEnabled(TRUE);
    return;
  }


  appendItem(\"\", \"\", userData, sh);
  sh.updatesEnabled(TRUE);
  LAYOUT_GROUP57.visible(true);
  PANEL_REF4.visible(true);

}

string appendItem(const string &rootId, const string &name, const anytype &value, const shape &sh)
{
//   DebugTN(__FUNCTION__, rootId, name, value, sh);
  string newId;

  if (!name.isEmpty())
    newId = rootId + \".\" + name;
  else
    newId = rootId;

  if (!newId.isEmpty() && !treeTestManagers.itemExists(newId))
    sh.appendItem(rootId, newId, name);

  if (isDynVar(value))
  {
    for (int i = 1; i <= dynlen(value); i++)
    {
      appendItem(newId, name + \" [\" + i + \"]\", value[i], sh);
    }
  }
  else if (isA(value, MAPPING_VAR))
  {
    for (int i = 1; i <= mappinglen(value); i++)
    {
      appendItem(newId,  mappingGetKey(value, i), mappingGetValue(value, i), sh);
    }
  }
  else
  {
    sh.setText(newId, 1, (string)value);
  }

  return newId;
}

//--------------------------------------------------------------------------------
void showProjInfo(string treeId)
{
  dyn_string children = treeTestProjects.children(treeId);
  if (children.count() > 0)
  {
    treeId = children.at(0);
    showProjInfo(treeId);
    return; // paralelel project
  }

  string cfgId = treeTestProjects.getText(treeId, 0);
  const string testprojCfgPath = testSuite.getTestProjCfgPath(cfgId);

  TfTestProject proj;
  proj.initFromJsonFile(testprojCfgPath);
  proj.setTestSuiteId(testSuite.getId());

  testProjRef.setProject(proj);
}
