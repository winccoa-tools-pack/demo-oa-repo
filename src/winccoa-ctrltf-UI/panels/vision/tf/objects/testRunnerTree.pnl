E "#uses \"classes/testFramework/TfCfg\"
#uses \"classes/globalStorage/GlobalStorage\"
#uses \"classes/testFramework/testRun/TfTestRun\"
#uses \"classes/oaTest/OaTestResultJson\"
#uses \"fileSystem\"
#uses \"classes/testFramework/TfFileSys\"

#event testRunSelected(TfTestRun tr)

GlobalStorage globalStorage = GlobalStorage(\"vision_tf\");

dyn_string testRunsIds;
void loadTestRuns()
{
  input_results_filter_global.enabled(FALSE);
  testRunsTree.clear();


  //get all test \"root\" test runs
  if (testRunsIds.count() <= 0)
  {
    // first init

    // read file
//     TfCfg cfgFile = TfCfg(TfTestRun::getConfigsPath());
//     cfgFile.enableSanitizeInterpolate = false;
//     cfgFile.read();
    TfTestRun tr;
    tr.initFromJsonFile(TfTestRun::getConfigsPath(), \"\");
    TfTestRun::enableSanitizeInterpolate = false;
    TfTestSuite::enableSanitizeInterpolate = false;
  //  tr.initFromMapping(cfgFile.getProperty(\"TEST_RUNS\"), \"\");

    testRunsIds = tr.getAllIds();
  }
  else
  {
    testRunsTree.updatesEnabled(FALSE);
  }

  if (testRunsIds.count() > 0)
  {
    testRunsIds.sort(false);

    // show root testRuns
    for (int i = 1; i <= testRunsIds.count(); i++)
    {
      string id = testRunsIds[i];
      _addTestRun(\"\", id);
    }
  }

  testRunsTree.setSorting(0, TRUE);
  testRunsTree.updatesEnabled(TRUE);
  input_results_filter_global.enabled(TRUE);
}

string globalFilter = \"*\";

synchronized setFilter()
{
  globalFilter = strtoupper(input_results_filter_global.text());

  if (globalFilter == \"\")
    globalFilter = \"*\";
  else
    globalFilter = \"*\" + globalFilter + \"*\";

  loadTestRuns();
}
//------------------------------------------------------------------------------
bool isFiltered(const TfTestRun &tr)
{
  if (patternMatch(globalFilter, strtoupper(tr.getId())))
    return TRUE;

  if (patternMatch(globalFilter, strtoupper(tr.getName())))
    return TRUE;

  if (patternMatch(globalFilter, strtoupper(tr.getDescription())))
    return TRUE;

  return FALSE;
}

mapping testRunsCahe;
string currentTestRunId;
_addTestRun(const string &rootId, const string &trId)
{
  TfTestRun tr;
  bool canInit = TRUE;

  if (!testRunsCahe.contains(trId))
  {
    int rc = tr.initFromCache(trId);
    canInit = rc == 0;

    testRunsCahe[trId] = tr;
  }
  else
  {
    tr = testRunsCahe[trId];
  }

  if (!isFiltered(tr))
    return;

  string uniqueId = rootId;

  if (!uniqueId.isEmpty())
    uniqueId += \";\";

  uniqueId += trId;
  testRunsTree.appendItem(rootId, uniqueId, trId);
  testRunsTree.setText(uniqueId, 1, (string)tr.getName());
  testRunsTree.setToolTip(uniqueId, 0, (string)tr.getName());

  string description = tr.getDescription();
  description.replace(\". \", \"\\n\");
  description.replace(\"? \", \"\\n\");
  description.replace(\"! \", \"\\n\");
  testRunsTree.setText(uniqueId, 2, description);
  testRunsTree.setToolTip(uniqueId, 1, description);


  if (!canInit)
  {
    setColorRecursive(uniqueId, 0, \"WF_Error\");
  }

  // show childerns
  dyn_string childIDs = tr.getChildren();

  for (int i = 1; i <= childIDs.count(); i++)
  {
    _addTestRun(uniqueId, childIDs[i]);
  }
}

setColorRecursive(string treeId, int idx, string color)
{
  int i;
  while (treeId != \"\" && i < 10)
  {
    testRunsTree.setBackColor(treeId, idx, color);
    if (!treeId.contains(\";\"))
      treeId = \"\";
    else
      treeId = substr(treeId, 0, treeId.lastIndexOf(\";\"));
    i++;
  }
}


