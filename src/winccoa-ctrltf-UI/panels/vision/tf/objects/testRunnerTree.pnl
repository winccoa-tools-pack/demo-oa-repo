main()
{
  this.enabled(FALSE);
  this.addColumn(\"ID\");
  this.setColumnWidthMode(0, TREE_WIDTH_MAXIMUM);
  this.addColumn(\"Name\");
  this.setColumnWidthMode(1, TREE_WIDTH_STRETCH);
  this.addColumn(\"Description\");
  this.hideColumn(2, TRUE);
  this.sortingEnabled(TRUE);
  this.alternatingRowColors(TRUE);
  this.animated(TRUE);
  loadTestRuns();


  string lastSelected = globalStorage.getValue(\"testRunner_lastSelected\", \"\");

  if (!lastSelected.isEmpty() && this.itemExists(lastSelected))
  {
    this.setSelectedItem(lastSelected, TRUE);
    this.ensureItemVisible(lastSelected, \"PositionAtCenter\");
  }
  else if (testRunsCahe.count() > 0)
  {
    TfTestRun tr = testRunsCahe.valueAt(1);
    this.setSelectedItem(tr.getId(), TRUE);
    this.ensureItemVisible(lastSelected);
//    triggerEvent(self.testRunSelected, tr);
  }

  this.enabled(TRUE);
}
