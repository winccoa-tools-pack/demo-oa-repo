E "#uses \"var\"
#uses \"classes/testFramework/testManager/TfTestManager\"
#uses \"classes/testFramework/testProject/TfTestProject\"

TfTestProject project;
public setProject(const TfTestProject &proj)
{
  project = proj;
  commonConfigRef.setId(project.getId());
  commonConfigRef.setName(project.getName());
  commonConfigRef.setDescription(project.getDescription());
  mapping projOpts;
  project.insertToMapping(projOpts);

  treeTestManagers.updatesEnabled(FALSE);
  treeTestManagers.clear();

  shape sh = getShape(\"treeTestManagers\");
  dyn_anytype testManagers = project.getTestManagers();

  for (int i = 1; i <= testManagers.count(); i++)
  {
    TfTestManager testMan = testManagers[i];
    mapping opts = testMan.toMapping();

    treeTestManagers.appendItem(\"\", i, mappingCutValueDflt(opts, \"MANAGER_OPTIONS\", i));

    appendItem(i, \"\", opts, sh);
  }

  treeTestManagers.updatesEnabled(TRUE);
  treeOptions.updatesEnabled(FALSE);
  treeOptions.clear();

  sh = getShape(\"treeOptions\");
  projOpts = mappingCutValueDflt(projOpts, \"INPUT_OPTIONS\", makeMapping());
  mappingCutValueDflt(projOpts, \"NAME\", \"\");
  mappingCutValueDflt(projOpts, \"ID\", \"\");
  mappingCutValueDflt(projOpts, \"DESCRIPTION\", \"\");
  mappingCutValueDflt(projOpts, \"TEST_MANAGERS\", \"\");
  mappingCutValueDflt(projOpts, \"SUB_PROJS_PATH\", \"\");
  appendItem(\"\", \"\", projOpts, sh);
  treeOptions.updatesEnabled(TRUE);
}

string appendItem(const string &rootId, const string &name, const anytype &value, const shape &sh)
{
  string newId;

  if (!name.isEmpty())
    newId = rootId + \".\" + name;
  else
    newId = rootId;

  if (!newId.isEmpty() && !treeTestManagers.itemExists(newId))
    sh.appendItem(rootId, newId, name);

  if (isDynVar(value))
  {
    for (int i = 1; i <= dynlen(value); i++)
    {
      appendItem(newId, name + \" [\" + i + \"]\", value[i], sh);
    }
  }
  else if (isA(value, MAPPING_VAR))
  {
    for (int i = 1; i <= mappinglen(value); i++)
    {
      appendItem(newId,  mappingGetKey(value, i), mappingGetValue(value, i), sh);
    }
  }
  else
  {
    sh.setText(newId, 1, (string)value);
  }

  return newId;
}

