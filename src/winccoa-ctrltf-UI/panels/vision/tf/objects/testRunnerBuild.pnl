"main()
{
  for (int i = 0; i < this.itemCount(); i++)
  {
    string key = this.text(i);
    this.text(i, getCatStr(\"testRunner\", key));
    int state = globalStorage.getValue(key);
    this.state(i, state);
    dynAppend(checkBoxKeys, key);

    switch (key)
    {
      case \"testRunner_enableNotifications\":
        input_testRunner_usersToNotify.enabled(state);
        testRunner_usersToNotify.enabled(state);
        break;

      case \"testRunner_enableHttpClient\":
        input_testRunner_http_port.enabled(state);
        testRunner_http_port.enabled(state);
        input_testRunner_https_port.enabled(state);
        testRunner_https_port.enabled(state);
        break;
    }
  }
}
" 0
"main(int button, int state)
{
  const string key = checkBoxKeys[button + 1];
  globalStorage.setValue(key, (string)state);

  switch (key)
  {
    case \"testRunner_enableNotifications\":
      input_testRunner_usersToNotify.enabled(state);
      testRunner_usersToNotify.enabled(state);
      break;

    case \"testRunner_enableHttpClient\":
      input_testRunner_http_port.enabled(state);
      testRunner_http_port.enabled(state);
      input_testRunner_https_port.enabled(state);
      testRunner_https_port.enabled(state);
      break;
  }
}
