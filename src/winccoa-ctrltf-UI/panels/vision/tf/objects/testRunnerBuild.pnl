"main()
{
  addGlobal(\"checkBoxKeys\", DYN_STRING_VAR);
  uiConnect(\"testRunSelected\", \"testRunnerTreeModule.testRunnerTree:\", \"testRunSelected\");
}

void testRunSelected(const TfTestRun &tr)
{
  commonConfigRef.setId(tr.getId());
  commonConfigRef.setName(tr.getName());
  commonConfigRef.setDescription(tr.getDescription());

  if (tr.hasTestSuite())
  {
    testSuiteRef.visible(TRUE);
    TfTestSuite testSuite = tr.getTestSuite();
    testSuiteRef.setTestSuite(testSuite);
    showStartOptions(!btn_showStartOptions.toggleState());
  }
  else
  {
    testSuiteRef.visible(FALSE);
    showStartOptions(TRUE);
  }
}
