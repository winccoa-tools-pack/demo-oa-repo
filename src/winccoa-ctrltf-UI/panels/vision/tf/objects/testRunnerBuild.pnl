#uses \"classes/globalStorage/GlobalStorage\"
#uses \"classes/projectEnvironment/ProjEnvComponent\"



// global dyn_string checkBoxKeys;

GlobalStorage globalStorage = GlobalStorage(\"testRunner\");

void setPanelValue(const string &key)
{
  globalStorage.setValue(key, (string)this.text());
}


void setDefValue(const string &key, const anytype &defValue)
{
  globalStorage.setValue(key, defValue);
}

void updatePanelValue(const string &key)
{
  this.text() = globalStorage.getValue(key);
}


void showStartOptions(const bool &show)
{
  if (show)
  {
    LAYOUT_GROUP_START_OPTIONS.visible(TRUE);
    btn_showStartOptions.buttonUpPixmap = \"wf/buttons/down.png\";
    btn_showStartOptions.buttonDownPixmap = \"wf/buttons/down_pressed.png\";
  }
  else
  {
    LAYOUT_GROUP_START_OPTIONS.visible(FALSE);
    btn_showStartOptions.buttonDownPixmap = \"wf/buttons/up.png\";
    btn_showStartOptions.buttonUpPixmap = \"wf/buttons/up_pressed.png\";

  }
}

