E "#uses \"classes/testFramework/testRun/TfTestRun\"
#uses \"classes/oaTest/OaTestResultJson\"
#uses \"fileSystem\"
#uses \"classes/testFramework/TfFileSys\"

#event showTestResult(OaTestResult result)

mapping resultsCache;
TfTestRun testRun;


dyn_string fswMonitoredPathes;
//--------------------------------------------------------------------------------
fswAddPathRecursive(const string &path)
{
  if (!fswMonitoredPathes.contains(path))
  {
    fswAddPath(path);
    dynAppend(fswMonitoredPathes, path);
  }

  dyn_string subDirs = getSubDirNames(path);

  for (int i = 1; i <= dynlen(subDirs); i++)
  {
    fswAddPathRecursive(path + subDirs[i] + \"/\");
  }
}

//--------------------------------------------------------------------------------
synchronized newResultFound(string eventName, string path)
{
  fswAddPathRecursive(path); // be sure new directories are added in to watcher
  loadResults();
}

//--------------------------------------------------------------------------------
void testRunFinished(const string &testRunID)
{
  loadResults();
}

void loadResults()
{
  string resDir = TfFileSys::getTestInstallPath(TfFileSysPath::ResultsPartly);

  if (resDir == \"\")
    return;

  testTree.updatesEnabled(FALSE);
//   testTree.clear();
//   resultsCache.clear();
  //Return a list with all executed testSuites and merge it
  dyn_string testSuiteIds = getSubDirNames(resDir);

  for (int i = 1; i <= dynlen(testSuiteIds); i++)
  {
    _addSuite(testSuiteIds[i], resDir);
  }

  testTree.updatesEnabled(TRUE);

}

//--------------------------------------------------------------------------------
//@private members
//--------------------------------------------------------------------------------

//--------------------------------------------------------------------------------
_addSuite(const string &tsName, const string &resDir)
{
  OaTestResult summary;

  // add only not existing items (due refresh)
  if (!testTree.itemExists(tsName))
  {
    testTree.appendItem(\"\", tsName, tsName);
  }

  dyn_string projects = getSubDirNames(resDir + tsName);

  for (int i = 1; i <= dynlen(projects); i++)
  {
    OaTestResult stat;
    _addProj(tsName, projects[i], resDir, stat);

    summary.opPlus(stat);
  }

  testTree.setText(tsName, 9, resDir + tsName);
  resultsCache[resDir + tsName] = summary;
  updateStat(tsName, summary.getStatistic());
}

//--------------------------------------------------------------------------------
_addProj(const string &tsName, const string &projName, const string &resDir, OaTestResult &summary)
{
  string projUniqueId = tsName + \";\" + projName;

  // add only not existing items (due refresh)
  if (!testTree.itemExists(projUniqueId))
  {
    testTree.appendItem(tsName, projUniqueId, projName);
    testTree.setText(projUniqueId, 7, tsName);
    testTree.setText(projUniqueId, 8, projName);
  }

  //Return all JSON result files
  dyn_string items = getFileNamesRecursive(resDir + tsName + \"/\" + projName, \"*.json\");

  for (int i = 1; i <= dynlen(items); i++)
  {
    const string path = items[i];
    const string fileName = baseName(path);
    string uniqueId = tsName + \";\" + projName + \";\" + fileName;



    OaTestResultJson jsonResult;

    // this result is store, just update the statistc (due refresh)
    if (resultsCache.contains(path))
    {
      jsonResult = resultsCache[path];
      summary.opPlus(jsonResult);
      continue;
    }



    bool canRead = jsonResult.fromFile(path) == 0;
    resultsCache[path] = jsonResult;

    if (!testTree.itemExists(uniqueId))
    {
      testTree.appendItem(projUniqueId, uniqueId, fileName);
      testTree.setText(uniqueId, 7, tsName);
      testTree.setText(uniqueId, 8, projName);
      testTree.setText(uniqueId, 9, path);
    }

    if (! canRead)
    {
      // can not read result (wrong format or manager chrash)

      // result file before test finished is named 'result.json'
      // this is normally empty. Therefore ignore it as error.
      if (baseName(\"result.json\"))
      {
        mappingRemove(resultsCache, path);
        continue;
      }


      testTree.setText(uniqueId, 0, baseName(path));
      testTree.setBackColor(uniqueId, 0, \"WF_ParamIncorrect\");
      testTree.setText(uniqueId, 1, \"Wrong file format. Manager crashed?\");
      testTree.setBackColor(uniqueId, 1, \"WF_ParamIncorrect\");
      continue;
    }

    OaTestResultTestManager testManager = jsonResult.getTestManager();
    string cmd = strltrim(strrtrim(testManager.cmd));
    string scriptName;
    scriptName = substr(cmd, strpos(cmd, \" \"));

    if (cmd.contains(\"-config \"))
      scriptName = substr(scriptName, 0, strpos(scriptName, \"-config \"));

    if (scriptName.isEmpty())
      scriptName = baseName(path);

    testTree.setText(uniqueId, 0, scriptName);
    testTree.setToolTip(uniqueId, 0, cmd);


    OaTestResultStatistic stat = jsonResult.getStatistic();
    updateStat(uniqueId, stat);
    summary.opPlus(jsonResult);
  }

  testTree.setText(projUniqueId, 9, resDir + tsName + \"/\" + projName);
  resultsCache[resDir + tsName + \"/\" + projName] = summary;
  updateStat(projUniqueId, summary.getStatistic());
}

//--------------------------------------------------------------------------------
updateStat(const string treeId, OaTestResultStatistic stat)
{
  stat.formatAddZeroCounter = FALSE;
  stat.formatTrimFirstAndLastNewLine = TRUE;
  const int passed = stat.getPassed();
  const int failed = stat.getFailed();
  const int aborted = stat.getAborted();
  const int knownBugs = stat.getKnownBugs();
  const int skipped = stat.getSkipped();
  const int instable = stat.getInstable();

  testTree.setText(treeId, 1, passed);
  testTree.setText(treeId, 2, failed);
  testTree.setText(treeId, 3, aborted);
  testTree.setText(treeId, 4, knownBugs);
  testTree.setText(treeId, 5, skipped);
  testTree.setText(treeId, 6, instable);
  testTree.setText(treeId, 10, stat.formatToStdErr(\"\\n%s: %d\"));

  if (passed == stat.getAll())
    testTree.setBackColor(treeId, 0, \"WF_Info\");
  else if (passed + knownBugs == stat.getAll())
    testTree.setBackColor(treeId, 0, \"WF_Warning\");
  else
    testTree.setBackColor(treeId, 0, \"WF_Error\");
}


