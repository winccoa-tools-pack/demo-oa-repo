"#uses \"fileSystem\"

main()
{
  this.addColumn(\"Name\");
  this.setColumnWidthMode(0, TREE_WIDTH_STRETCH);
  this.addColumn(\"Passed\");
  this.hideColumn(1, TRUE);
  this.addColumn(\"Failed\");
  this.hideColumn(2, TRUE);
  this.addColumn(\"Aborted\");
  this.hideColumn(3, TRUE);
  this.addColumn(\"KnownBugs\");
  this.hideColumn(4, TRUE);
  this.addColumn(\"Skipped\");
  this.hideColumn(5, TRUE);
  this.addColumn(\"Instable\");
  this.hideColumn(6, TRUE);
  this.addColumn(\"TestSuite\");
  this.hideColumn(7, TRUE);
  this.addColumn(\"TestProj\");
  this.hideColumn(8, TRUE);
  this.addColumn(\"TestResultFile\");
  this.hideColumn(9, TRUE);

  this.addColumn(\"Summary\");

  this.alternatingRowColors(TRUE);
  loadResults();

  uiConnect(\"testRunFinished\", \"testRunFinished\");

  string resDir = makeUnixPath(TfFileSys::getTestInstallPath(TfFileSysPath::ResultsPartly));

  if (resDir != \"\")
  {
    fswAddPathRecursive(resDir);
    sysConnect(\"newResultFound\", \"fswPathChanged\");
  }
}

