""0  1
E "#uses \"classes/oaTest/OaTestResultStatistic\"
#uses \"classes/oaTest/OaTestResult\"
#uses \"classes/oaTest/OaTestUserData\"
// #uses \"classes/oaTest/OaTestResultJUnit\"
#uses \"classes/oaTest/OaTestResultJson\"

enum OaTestResultPanelColumns
{
  Name = 0,
  Timestamp,
  Duration,
  Status,
  StatusAsInt
};

struct OaTestResulPanelStatistic : OaTestResultStatistic
{
  time startTime = 0.0;
  time endTime = 0.0;
  float duration;
  dyn_string knownBugIds;

  void update(const OaTestUserData &assertion)
  {

    if (this.startTime == (uint)0 || this.startTime > assertion.getStartTimeStamp())
      this.startTime = assertion.getStartTimeStamp();

    if (this.endTime < assertion.getEndTimeStamp())
      this.endTime = assertion.getEndTimeStamp();

    this.duration = this.endTime - this.startTime;

    const OaTestResultState state = assertion.getResultState();

    switch (state)
    {
      case OaTestResultState::Pass:
        this._passed++;
        break;

      case OaTestResultState::Failure:
        this._failed++;
        break;

      case OaTestResultState::Abort:
        this._aborted++;
        break;

      case OaTestResultState::KnownBug:
        this._knownBugs++;
        break;

      case OaTestResultState::Skipped:
        this._skipped++;
        break;

      case OaTestResultState::Instable:
        this._instable++;
        break;
    }
  }
};

class OaTestResulPanel : OaTestResult
{
  public string globalFilter;
  public string testCaseIdFilter;
  public string errMsgFilter;
  public string knownBugFilter;
  public string noteFilter;

  public shape<\"TREE\"> tree;

  //------------------------------------------------------------------------------
  public int convert()
  {
    tree.updatesEnabled(FALSE);
    tree.clear();
    tree.sortingEnabled(TRUE);

    convertTestCases();
    tree.updatesEnabled(TRUE);
  }

  //------------------------------------------------------------------------------
  protected convertTestCases()
  {
    dyn_anytype tcs = getTestCases(TRUE); // group by id

    for (int i = 1; i <= dynlen(tcs); i++)
    {
      convertAssertions(tcs[i]);
      dynClear(tcs[i]);
    }

    tree.setSorting((int)OaTestResultPanelColumns::StatusAsInt, FALSE); // worst case on top
  }

  //------------------------------------------------------------------------------
  bool isFiltered(const dyn_anytype &assertions)
  {
    for (int i = 1; i <= dynlen(assertions); i++)
    {
      const OaTestUserData assertion = assertions[i];
      bool show = TRUE;

//       if (assertion.getKnownBug() != \"\")
//       {
//         DebugN(assertion.getTcId(), assertion.getKnownBug(), \"globalFilter\", globalFilter, \"testCaseIdFilter\", testCaseIdFilter, \"errMsgFilter\", errMsgFilter, \"knownBugFilter\", knownBugFilter, \"noteFilter\", noteFilter);
//       }

      show = compareFields(globalFilter, assertion.getTcId()) &&
             compareFields(globalFilter, assertion.getErrMsg()) &&
             compareFields(globalFilter, assertion.getKnownBug()) &&
             compareFields(globalFilter, assertion.getNote()) &&
             compareFields(testCaseIdFilter, assertion.getTcId()) &&
             compareFields(errMsgFilter, assertion.getErrMsg()) &&
             compareFields(knownBugFilter, assertion.getKnownBug()) &&
             compareFields(noteFilter, assertion.getNote());

      if (!show)
        return FALSE;
    }

    return TRUE;
  }

  //------------------------------------------------------------------------------
  bool compareFields(string filter, string value)
  {
    if (value == \"21208\")
      DebugTN(__FUNCTION__, filter, value);

    if (filter == \"\")
      return true;

    filter = filter.toUpper();
    value = value.toUpper();

    if (filter == value)
      return true;
    else if (value.contains(filter))
      return true;
    else if (patternMatch(filter, value))
      return true;
    else if (regexpIndex(filter, value) > 0)
      return true;
    else
    {
//       DebugTN(__FUNCTION__, \"no match\", filter, value);
      return false;
    }

  }

  //------------------------------------------------------------------------------
  protected convertAssertions(dyn_anytype &assertions)
  {
    if (dynlen(assertions) < 1)
      return; // there are no relevant assertions

    if (!isFiltered(assertions))
      return;

    const string tcId = assertions[1].getTcId();
    tree.insertItem(\"\", tcId, tcId);
    OaTestResulPanelStatistic tcStat = addTcDetail(tcId, assertions);

    //Time taken (in seconds) to execute the test.
    tree.setText(tcId, (int)OaTestResultPanelColumns::Duration, toDurationString(tcStat.duration));
    tree.setText(tcId, (int)OaTestResultPanelColumns::Timestamp, (string)tcStat.startTime);
  }

  //------------------------------------------------------------------------------
  protected string tcStateToColor(const OaTestResultState &state)
  {
    switch (state)
    {
      case OaTestResultState::Pass:
        return \"WF_Info\";

      case OaTestResultState::Failure:
        return \"WF_Error\";

      case OaTestResultState::Abort:
        return \"WF_Error\";

      case OaTestResultState::KnownBug:
        return \"WF_Warning\";

      case OaTestResultState::Skipped:
        return \"WF_Error\";

      case OaTestResultState::Instable:
        return \"WF_Warning\";
    }

    return \"WF_ParamIncorrect\";
  }

  //------------------------------------------------------------------------------
  protected OaTestResulPanelStatistic addTcDetail(const string &tcId, dyn_anytype &assertions)
  {
    OaTestResulPanelStatistic tcStat;

    if (dynlen(assertions) <= 0)
      return tcStat;

    int worstCaseIdx;
    OaTestResultState state;
    bool hasResult = false;
    dyn_string knownBugIds;

    tree.insertItem(tcId, tcId + \".logEntries\", \"Logs\");

    for (int i = 1; i <= dynlen(assertions); i++)
    {
      const OaTestUserData assertion = assertions[i];

      tcStat.update(assertion);

      assertionToLog(assertion, i, tcId);

      if (\"oaUnitInfo\" == assertion.getMethod())
      {
        continue; // oaUnitInfo message
      }

      hasResult = true;

      if (assertion.hasKnownBug())
      {
        dynAppend(knownBugIds, assertion.getKnownBug());
      }

      const string stateStr = assertion.getResult();
      const OaTestResultState currState = assertion.getResultState();
      const bool hasKnownBug = assertion.hasKnownBug();

      if ((int)state < (int)currState)
      {
        state = currState;
        tree.setText(tcId, (int)OaTestResultPanelColumns::Status, stateStr);
        tree.setBackColor(tcId, (int)OaTestResultPanelColumns::Status, tcStateToColor(state));
        tree.setText(tcId, (int)OaTestResultPanelColumns::StatusAsInt, (int)state);
      }
    }

    string details = tcStat.formatToStdErr(\"%s : %d, \");
    details = details.left(details.length() - 2);
    tree.insertItem(tcId, tcId + \".details\", details);
//     tree.insertItem(tcId + \".details\", tcId + \".details.Stat\", tcStat.formatToStdErr(\"%s : %d \"));
    tree.setOpen(tcId + \".details\", TRUE);

    if (dynlen(knownBugIds) > 0)
    {
      dynUnique(knownBugIds);
      dynSort(knownBugIds);

      string str;
      sprintf(str, \"%s (%d)\", \"Known bugs\", dynlen(knownBugIds));

      tree.insertItem(tcId + \".details\", tcId + \".details.KnownBugs\", str);

      for (int i = dynlen(knownBugIds); i > 0 ; i--)
      {
        tree.appendItem(tcId + \".details.KnownBugs\", tcId + \".details.KnownBugs.\" + i, knownBugIds[i]);
      }
    }

    return tcStat;
  }

  //------------------------------------------------------------------------------
  protected void assertionToLog(const OaTestUserData &assertion, const int &index, const string &tcId)
  {
    string logEntry;


    // stack trace
    logEntry = (string)assertion.getEndTimeStamp() + \": \";
    logEntry += assertion.getErrMsg();
    logEntry += \"\\n  Duration: \" + toDurationString(assertion.getDuration());
    logEntry += \"\\n  Location: \" + assertion.getLocation();

    tree.appendItem(tcId + \".logEntries\", tcId + \".logEntries.\" + index, makeUnixPath(logEntry));

    if (assertion.getMethod() != \"oaUnitInfo\")
      tree.setBackColor(tcId + \".logEntries.\" + index, (int)OaTestResultPanelColumns::Name, tcStateToColor(assertion.getResultState()));
  }


  //------------------------------------------------------------------------------
  const int secInDay = 3600 * 24;
  string toDurationString(const float &duration)
  {
    int d = (int)duration / secInDay;
    int h = ((int)duration - (d * secInDay)) / 3600;

    if (d > 0)
      return d + \" Days \" + h + \" Hours\";

    int m = ((int)duration - (d * secInDay) - (h * 3600)) / 60;

    if (h > 0)
      return h + \" Hours \" + m + \" Min.\";

    int s = ((int)duration - (d * secInDay) - (h * 3600) - (m * 60)) / 60;

    if (m > 0)
      return m + \" Min. \" + (int)s + \" s\";

    return (string)duration + \" s.ms\";

    return \"\";
  }


};




OaTestResulPanel result;


synchronized void setFilter()
{

  result.globalFilter = input_results_filter_global.text();
  result.testCaseIdFilter = input_results_filter_TC_ID.text();
  result.errMsgFilter = input_results_filter_errMsg.text();
  result.knownBugFilter = input_results_filter_knownBug.text();
  result.noteFilter = input_results_filter_note.text();
  result.convert();


}

