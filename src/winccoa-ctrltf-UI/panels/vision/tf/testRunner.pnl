"main()
{
  splitter.addModule(\"testRunnerTreeModule\");
  splitter.addModule(\"testRunnerBuildModule\");


  splitter.setMinimumSize(\"testRunnerTreeModule\", 100);
  splitter.setCollapsible(\"testRunnerTreeModule\", FALSE);
  splitter.setMinimumSize(\"testRunnerBuildModule\", 1200);
  splitter.setCollapsible(\"testRunnerBuildModule\", FALSE);
  rootPanelOnModule(\"vision/tf/objects/testRunnerTree\", \"testRunnerTree\", \"testRunnerTreeModule\", \"\");
  rootPanelOnModule(\"vision/tf/objects/testRunnerBuild\", \"testRunnerBuild\", \"testRunnerBuildModule\", \"\");


  splitter.setMinimumSize(\"testRunnerBuildModule\", 100);
  dyn_int sizes = jsonDecode(globalStorage.getValue(\"testRunner_splitter_sizes\", \"[]\"));

  if ( dynlen(sizes) > 0 )
    splitter.setSizes(sizes);

  uiConnect(\"testRunSelected\", \"testRunnerTreeModule.testRunnerTree:\", \"testRunSelected\");
}

void testRunSelected(const TfTestRun &tr)
{
  btn_startTestRunner.enabled(TRUE);
}
