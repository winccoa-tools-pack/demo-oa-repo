"main(mapping event)
{

  ProjEnvComponent ctrlMan = ProjEnvComponent(CTRL_COMPONENT);

  mapping map;
  shape cbx_options = getShapeStrict(\"testRunnerBuildModule\", \"testRunnerBuild\", \"cbx_options\");

  for (int i = 0; i < cbx_options.itemCount() ; i++)
  {
    string option = checkBoxKeys[i + 1];
    option.remove(0, strlen(\"testRunner_\"));
    bool state = cbx_options.state(i);
    map[option] = state;
  }

  shape commonConfigRef = getShapeStrict(\"testRunnerBuildModule\", \"testRunnerBuild\", \"commonConfigRef\");
  map[\"testRunId\"] = (string)commonConfigRef.getId();
  shape input_testRunner_usersToNotify = getShapeStrict(\"testRunnerBuildModule\", \"testRunnerBuild\", \"input_testRunner_usersToNotify\");
  map[\"usersToNotify\"] = (string)input_testRunner_usersToNotify.text();
  shape input_testRunner_http_port = getShapeStrict(\"testRunnerBuildModule\", \"testRunnerBuild\", \"input_testRunner_http_port\");
  shape input_testRunner_https_port = getShapeStrict(\"testRunnerBuildModule\", \"testRunnerBuild\", \"input_testRunner_https_port\");
  map[\"http\"] = makeMapping(\"port\", (int)(string)input_testRunner_http_port.text(), \"sPort\", (int)(string)input_testRunner_https_port.text());
  shape input_testRunner_ext_manager_options = getShapeStrict(\"testRunnerBuildModule\", \"testRunnerBuild\", \"input_testRunner_ext_manager_options\");
  dyn_string options = makeDynString(\"testRunner.ctl\", \"-n\", jsonEncode(map), (string)input_testRunner_ext_manager_options.text());

  ctrlMan.setOptions(options);
  this.enabled(FALSE);
  ctrlMan.start();
  this.enabled(TRUE);
  triggerEvent(self.testRunFinished, map[\"testRunId\"]);
}
