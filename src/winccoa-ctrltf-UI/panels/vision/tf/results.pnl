"main()
{
  splitter.addModule(\"testResultTreeModule\");
  splitter.addModule(\"testResultTableModule\");

  dyn_int sizes = jsonDecode(globalStorage.getValue(\"testResult_splitter_sizes\", \"[]\"));

  if ( dynlen(sizes) > 0 )
    splitter.setSizes(sizes);

  rootPanelOnModule(\"vision/tf/objects/resultsTree\", \"testResultTree\", \"testResultTreeModule\", \"\");
  rootPanelOnModule(\"vision/tf/objects/resultsTable\", \"testResultTable\", \"testResultTableModule\", \"\");

  splitter.setMinimumSize(\"testResultTreeModule\", 100);
  splitter.setCollapsible(\"testResultTreeModule\", FALSE);
}
